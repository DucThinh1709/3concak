@model MenStyle.Web.ViewModels.ProductDetailViewModel

@{
    ViewData["Title"] = Model.Product.Name;

    string FormatPrice(decimal price)
    {
        return $"{price:N0}đ".Replace(",", ".");
    }

    int GetSalePercent(decimal oldPrice, decimal price)
    {
        if (oldPrice <= 0 || oldPrice <= price)
        {
            return 0;
        }

        return (int)Math.Round((double)((oldPrice - price) / oldPrice * 100));
    }

    var defaultSize = Model.Sizes.FirstOrDefault() ?? "";
    var defaultColor = Model.Colors.FirstOrDefault() ?? "";

    var salePercent = GetSalePercent(Model.Product.OldPrice, Model.Product.Price);

    string NormalizeSizeKey(string size)
    {
        var key = (size ?? "")
            .Trim()
            .ToUpperInvariant()
            .Replace(" ", "")
            .Replace("-", "");

        return key switch
        {
            "2XL" => "XXL",
            "XXLARGE" => "XXL",
            "3XLARGE" => "3XL",
            "ONESIZE" => "FREESIZE",
            "FREE" => "FREESIZE",
            _ => key
        };
    }

    (int MinHeight, int MaxHeight, int MinWeight, int MaxWeight)? GetSizeRange(string size)
    {
        return NormalizeSizeKey(size) switch
        {
            "XS" => (145, 157, 35, 47),
            "S" => (150, 163, 40, 53),
            "M" => (156, 169, 50, 63),
            "L" => (163, 176, 60, 73),
            "XL" => (170, 183, 70, 83),
            "XXL" => (175, 189, 80, 96),
            "3XL" => (178, 195, 90, 112),
            "FREESIZE" => (150, 185, 40, 90),
            _ => null
        };
    }

    var productSizeGuideRows = Model.Sizes
        .Select(size => new { Size = size, Range = GetSizeRange(size) })
        .Where(item => item.Range.HasValue)
        .Select(item => new { item.Size, Range = item.Range!.Value })
        .ToList();
}

<main class="product-detail-page">

    <section class="product-detail-section">
        <div class="container product-detail-layout">

            <div class="product-detail-gallery">
                <div class="product-detail-image product-img-sale">

                    @if (salePercent > 0)
                    {
                        <span class="sale-badge detail-sale-badge">
                            -@salePercent%
                        </span>
                    }

                    <img id="mainProductImage"
                         src="@Model.Product.ImageUrl"
                         alt="@Model.Product.AltText" />
                </div>

                <div class="product-detail-badges">
                    <span>@Model.Product.CategoryName</span>

                    @if (salePercent > 0)
                    {
                        <span>Đang sale -@salePercent%</span>
                    }

                    @if (Model.Product.StockQuantity > 0)
                    {
                        <span>Còn hàng</span>
                    }
                    else
                    {
                        <span>Hết hàng</span>
                    }
                </div>
            </div>

            <div class="product-detail-info">
                <p class="eyebrow">MENSTYLE PRODUCT</p>

                <h1>@Model.Product.Name</h1>

                <div class="detail-price-row">
                    <strong>@FormatPrice(Model.Product.Price)</strong>

                    @if (salePercent > 0)
                    {
                        <del>@FormatPrice(Model.Product.OldPrice)</del>
                    }
                </div>

                @if (salePercent > 0)
                {
                    <div class="detail-sale-info">
                        <span>Đang sale -@salePercent%</span>
                        <strong>Tiết kiệm @FormatPrice(Model.Product.OldPrice - Model.Product.Price)</strong>
                    </div>
                }

                <p class="detail-description">
                    @Model.Product.Description
                </p>

                <div class="detail-meta-grid">
                    <div>
                        <span>Chất liệu</span>
                        <strong>@Model.Product.Material</strong>
                    </div>

                    <div>
                        <span>Form dáng</span>
                        <strong>@Model.Product.Fit</strong>
                    </div>

                    <div>
                        <span>Tồn kho</span>
                        <strong>@Model.Product.StockQuantity sản phẩm</strong>
                    </div>

                    <div>
                        <span>Danh mục</span>
                        <strong>@Model.Product.CategoryName</strong>
                    </div>
                </div>

                <form asp-controller="Cart"
                      asp-action="Add"
                      asp-route-id="@Model.Product.Id"
                      method="post"
                      class="detail-add-cart-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="returnUrl"
                           value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />

                    <div class="detail-option-group">
                        <label>Chọn size</label>

                        <div class="size-option-list">
                            @foreach (var size in Model.Sizes)
                            {
                                <label class="size-option">
                                    <input type="radio"
                                           name="selectedSize"
                                           value="@size"
                                           checked="@(size == defaultSize)" />
                                    <span>@size</span>
                                </label>
                            }
                        </div>
                    </div>

                    <details class="size-guide-card" open>
                        <summary>
                            <span>
                                <strong>Gợi ý chọn size</strong>
                                <small>Theo chiều cao và cân nặng của bạn</small>
                            </span>
                            <span class="size-guide-chevron" aria-hidden="true">⌄</span>
                        </summary>

                        <div class="size-guide-content">
                            <p class="size-guide-intro">
                                Bảng dưới đây chỉ hiển thị các size hiện có của
                                <strong>@Model.Product.Name</strong>.
                            </p>

                            @if (productSizeGuideRows.Any())
                            {
                                <div class="size-recommend-form" aria-label="Nhập số đo để gợi ý size">
                                    <label for="customerHeight">
                                        Chiều cao
                                        <span class="size-input-wrap">
                                            <input id="customerHeight"
                                                   type="number"
                                                   min="130"
                                                   max="210"
                                                   step="1"
                                                   inputmode="numeric"
                                                   placeholder="Ví dụ: 170" />
                                            <small>cm</small>
                                        </span>
                                    </label>

                                    <label for="customerWeight">
                                        Cân nặng
                                        <span class="size-input-wrap">
                                            <input id="customerWeight"
                                                   type="number"
                                                   min="30"
                                                   max="150"
                                                   step="1"
                                                   inputmode="numeric"
                                                   placeholder="Ví dụ: 65" />
                                            <small>kg</small>
                                        </span>
                                    </label>

                                    <button id="recommendSizeBtn"
                                            type="button"
                                            class="size-recommend-btn">
                                        Gợi ý size
                                    </button>
                                </div>

                                <div class="size-guide-table-wrap">
                                    <table class="size-guide-table">
                                        <thead>
                                            <tr>
                                                <th scope="col">Size</th>
                                                <th scope="col">Chiều cao</th>
                                                <th scope="col">Cân nặng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in productSizeGuideRows)
                                            {
                                                <tr data-size="@row.Size"
                                                    data-min-height="@row.Range.MinHeight"
                                                    data-max-height="@row.Range.MaxHeight"
                                                    data-min-weight="@row.Range.MinWeight"
                                                    data-max-weight="@row.Range.MaxWeight">
                                                    <th scope="row">@row.Size</th>
                                                    <td>@row.Range.MinHeight – @row.Range.MaxHeight cm</td>
                                                    <td>@row.Range.MinWeight – @row.Range.MaxWeight kg</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div id="sizeRecommendationResult"
                                     class="size-recommend-result"
                                     aria-live="polite">
                                    <span id="recommendedSizeBadge"
                                          class="recommended-size-badge"
                                          hidden></span>
                                    <p id="sizeRecommendationMessage">
                                        Nhập chiều cao và cân nặng để nhận size phù hợp nhất.
                                    </p>
                                    <button id="applyRecommendedSizeBtn"
                                            type="button"
                                            class="size-apply-btn"
                                            hidden>
                                        Chọn size này
                                    </button>
                                </div>

                                <p class="size-guide-note">
                                    Bảng size mang tính tham khảo. Nếu bạn thích mặc rộng hoặc đang ở giữa hai size,
                                    hãy ưu tiên size lớn hơn.
                                </p>
                            }
                            else
                            {
                                <p class="size-guide-unavailable">
                                    Sản phẩm này dùng hệ size riêng. Vui lòng chọn một size đang hiển thị hoặc liên hệ
                                    cửa hàng để được tư vấn chính xác.
                                </p>
                            }
                        </div>
                    </details>

                    <div class="detail-option-group">
                        <label>Chọn màu sắc</label>

                        <div class="color-option-list">
                            @foreach (var color in Model.Colors)
                            {
                                var colorImage = Model.ColorImages.ContainsKey(color)
                                    ? Model.ColorImages[color]
                                    : Model.Product.ImageUrl;

                                <label class="color-option">
                                    <input type="radio"
                                           name="selectedColor"
                                           value="@color"
                                           data-image="@colorImage"
                                           checked="@(color == defaultColor)" />
                                    <span>@color</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="detail-quantity-box">
                        <label>Số lượng</label>

                        <input type="number"
                               name="quantity"
                               value="1"
                               min="1"
                               max="@Model.Product.StockQuantity" />
                    </div>

                    @if (Model.Product.StockQuantity > 0)
                    {
                        <button type="submit" class="btn btn-primary detail-cart-btn">
                            Thêm vào giỏ hàng
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary detail-cart-btn" disabled>
                            Sản phẩm đã hết hàng
                        </button>
                    }
                </form>

                <div class="care-box">
                    <h3>Hướng dẫn bảo quản</h3>
                    <p>@Model.Product.CareInstruction</p>
                </div>
            </div>

        </div>
    </section>

    <section class="related-products-section">
        <div class="container">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Related Products</p>
                    <h2>Sản phẩm liên quan</h2>
                </div>

                <a class="btn btn-outline"
                   asp-controller="Home"
                   asp-action="SanPham"
                   asp-route-category="@Model.Product.CategorySlug">
                    Xem thêm
                </a>
            </div>

            @if (!Model.RelatedProducts.Any())
            {
                <div class="empty-collection">
                    Chưa có sản phẩm liên quan.
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var product in Model.RelatedProducts)
                    {
                        var relatedSalePercent = GetSalePercent(product.OldPrice, product.Price);

                        <article class="product-card">
                            <a class="product-img product-img-sale"
                               asp-controller="Home"
                               asp-action="ChiTietSanPham"
                               asp-route-id="@product.Id">

                                @if (relatedSalePercent > 0)
                                {
                                    <span class="sale-badge">
                                        -@relatedSalePercent%
                                    </span>
                                }

                                <img src="@product.ImageUrl" alt="@product.AltText" />
                            </a>

                            <div class="product-info">
                                <div class="product-tag-row">
                                    <p class="tag">@product.CategoryName</p>

                                    @if (relatedSalePercent > 0)
                                    {
                                        <span class="sale-mini-tag">
                                            Đang sale
                                        </span>
                                    }
                                </div>

                                <h3>
                                    <a asp-controller="Home"
                                       asp-action="ChiTietSanPham"
                                       asp-route-id="@product.Id">
                                        @product.Name
                                    </a>
                                </h3>

                                <div class="price-row @(relatedSalePercent > 0 ? "sale-price-row" : "")">
                                    <strong>@FormatPrice(product.Price)</strong>

                                    @if (relatedSalePercent > 0)
                                    {
                                        <span>@FormatPrice(product.OldPrice)</span>
                                    }
                                </div>

                                @if (relatedSalePercent > 0)
                                {
                                    <p class="sale-save-text">
                                        Tiết kiệm @FormatPrice(product.OldPrice - product.Price)
                                    </p>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const mainImage = document.getElementById("mainProductImage");
            const colorRadios = document.querySelectorAll('input[name="selectedColor"]');

            if (mainImage && colorRadios.length > 0) {
                colorRadios.forEach(radio => {
                    radio.addEventListener("change", function () {
                        const newImage = this.dataset.image;

                        if (!newImage) return;

                        mainImage.classList.add("is-changing");

                        setTimeout(() => {
                            mainImage.src = newImage;
                            mainImage.classList.remove("is-changing");
                        }, 120);
                    });
                });
            }

            const heightInput = document.getElementById("customerHeight");
            const weightInput = document.getElementById("customerWeight");
            const recommendButton = document.getElementById("recommendSizeBtn");
            const applyButton = document.getElementById("applyRecommendedSizeBtn");
            const resultBox = document.getElementById("sizeRecommendationResult");
            const resultMessage = document.getElementById("sizeRecommendationMessage");
            const resultBadge = document.getElementById("recommendedSizeBadge");
            const sizeRows = Array.from(document.querySelectorAll(".size-guide-table tbody tr"));

            if (!heightInput || !weightInput || !recommendButton || sizeRows.length === 0) return;

            function distanceToRange(value, min, max) {
                if (value < min) return min - value;
                if (value > max) return value - max;
                return 0;
            }

            function clearRecommendation() {
                sizeRows.forEach(row => row.classList.remove("is-recommended"));
                resultBox?.classList.remove("is-error");
                resultBadge?.setAttribute("hidden", "");
                applyButton?.setAttribute("hidden", "");
            }

            function showInputError(message) {
                clearRecommendation();
                resultBox?.classList.add("is-error");

                if (resultMessage) {
                    resultMessage.textContent = message;
                }
            }

            function recommendSize() {
                const height = Number(heightInput.value);
                const weight = Number(weightInput.value);

                if (!heightInput.value || !weightInput.value) {
                    showInputError("Vui lòng nhập đầy đủ chiều cao và cân nặng.");
                    return;
                }

                if (!Number.isFinite(height) || height < 130 || height > 210) {
                    showInputError("Chiều cao hợp lệ nằm trong khoảng 130–210 cm.");
                    heightInput.focus();
                    return;
                }

                if (!Number.isFinite(weight) || weight < 30 || weight > 150) {
                    showInputError("Cân nặng hợp lệ nằm trong khoảng 30–150 kg.");
                    weightInput.focus();
                    return;
                }

                const candidates = sizeRows.map(row => {
                    const minHeight = Number(row.dataset.minHeight);
                    const maxHeight = Number(row.dataset.maxHeight);
                    const minWeight = Number(row.dataset.minWeight);
                    const maxWeight = Number(row.dataset.maxWeight);
                    const heightCenter = (minHeight + maxHeight) / 2;
                    const weightCenter = (minWeight + maxWeight) / 2;
                    const score = distanceToRange(height, minHeight, maxHeight) * 1.15
                        + distanceToRange(weight, minWeight, maxWeight) * 1.7
                        + Math.abs(height - heightCenter) * 0.04
                        + Math.abs(weight - weightCenter) * 0.07;

                    return {
                        row,
                        size: row.dataset.size,
                        score,
                        isExact: height >= minHeight && height <= maxHeight
                            && weight >= minWeight && weight <= maxWeight
                    };
                }).sort((first, second) => first.score - second.score);

                const recommendation = candidates[0];
                clearRecommendation();
                recommendation.row.classList.add("is-recommended");

                if (resultBadge) {
                    resultBadge.textContent = recommendation.size;
                    resultBadge.removeAttribute("hidden");
                }

                if (resultMessage) {
                    resultMessage.textContent = recommendation.isExact
                        ? `Size ${recommendation.size} phù hợp nhất với số đo bạn vừa nhập.`
                        : `Size ${recommendation.size} là lựa chọn gần nhất trong các size hiện có của sản phẩm.`;
                }

                if (applyButton) {
                    applyButton.dataset.recommendedSize = recommendation.size;
                    applyButton.textContent = `Chọn size ${recommendation.size}`;
                    applyButton.removeAttribute("hidden");
                }
            }

            recommendButton.addEventListener("click", recommendSize);

            [heightInput, weightInput].forEach(input => {
                input.addEventListener("keydown", function (event) {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        recommendSize();
                    }
                });
            });

            applyButton?.addEventListener("click", function () {
                const recommendedSize = this.dataset.recommendedSize;
                const targetSizeRadio = Array.from(
                    document.querySelectorAll('input[name="selectedSize"]')
                ).find(radio => radio.value === recommendedSize);

                if (!targetSizeRadio) return;

                targetSizeRadio.checked = true;
                targetSizeRadio.dispatchEvent(new Event("change", { bubbles: true }));
                targetSizeRadio.closest(".detail-option-group")?.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                if (resultMessage) {
                    resultMessage.textContent = `Đã chọn size ${recommendedSize}. Bạn có thể thêm sản phẩm vào giỏ hàng.`;
                }
            });
        });
    </script>
}
