@using MenStyle.Web.Models
@using Microsoft.AspNetCore.Identity
@using MenStyle.Web.Extensions
@using MenStyle.Web.ViewModels
@using MenStyle.Web.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;

    int cartQuantity = 0;

    if (currentUser is not null)
    {
        cartQuantity = await DbContext.ShoppingCartItems
            .Where(x => x.UserId == currentUser.Id)
            .SumAsync(x => (int?)x.Quantity) ?? 0;
    }
    ApplicationUser? layoutUser = null;
    string layoutDisplayName = "";
    string layoutAvatarUrl = "";
    string layoutAvatarInitial = "U";

    if (User.Identity?.IsAuthenticated == true)
    {
        layoutUser = await UserManager.GetUserAsync(User);

        layoutDisplayName = !string.IsNullOrWhiteSpace(layoutUser?.FullName)
            ? layoutUser.FullName
            : User.Identity.Name ?? "Tài khoản";

        layoutAvatarUrl = layoutUser?.AvatarUrl ?? "";

        layoutAvatarInitial = !string.IsNullOrWhiteSpace(layoutDisplayName)
            ? layoutDisplayName.Trim()[0].ToString().ToUpper()
            : "U";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MENSTYLE</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/button-system.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <div class="topbar">
            <span>Miễn phí vận chuyển cho đơn từ 499.000đ</span>
            <span>Hotline: 0909 123 456</span>
        </div>

        <nav class="navbar container">
            <a class="logo"
               asp-controller="Home"
               asp-action="Index"
               asp-fragment="home">
                MEN<span>STYLE</span>
            </a>

            <button class="mobile-toggle" aria-label="Mở menu">
                ☰
            </button>

            <div class="nav-links">
                <a class="nav-main-button"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="home">
                    Trang chủ
                </a>

                <div class="nav-mega-item">
                    <a class="nav-link mega-trigger nav-main-button"
                       asp-controller="Home"
                       asp-action="SanPham">
                        Sản phẩm <span>⌄</span>
                    </a>

                    <div class="mega-menu">
                        <div class="mega-menu-inner">
                            <div class="mega-column">
                                <h3>ÁO NAM</h3>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="ao-thun">
                                    Áo Thun
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="ao-polo">
                                    Áo Polo
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="ao-so-mi">
                                    Áo Sơ mi
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="ao-khoac">
                                    Áo Khoác
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="hoodie">
                                    Hoodie
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="set-do">
                                    Set đồ
                                </a>
                            </div>

                            <div class="mega-column">
                                <h3>QUẦN NAM</h3>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="quan-jean">
                                    Quần Jean
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="quan-short">
                                    Quần Short
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="quan-kaki-chino">
                                    Quần Kaki & Chino
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="quan-jogger">
                                    Quần Jogger
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="quan-tay">
                                    Quần Tây
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="set-do">
                                    Set Đồ
                                </a>
                            </div>

                            <div class="mega-column mega-highlight">
                                <h3>HÀNG MỚI</h3>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-sort="default">
                                    Sản phẩm mới nhất
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="basic-de-phoi">
                                    Basic dễ phối
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-category="oversize">
                                    Oversize
                                </a>

                                <a class="mega-sale-link"
                                   asp-controller="Home"
                                   asp-action="SanPham"
                                   asp-route-saleOnly="true">
                                    Đang sale
                                </a>

                            </div>

                            <div class="mega-column">
                                <h3>HÀNG BÁN CHẠY</h3>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-keyword="Áo thun">
                                    Áo thun bán chạy
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-keyword="Áo sơ mi">
                                    Sơ mi được yêu thích
                                </a>

                                <a asp-controller="Home" asp-action="SanPham" asp-route-keyword="Áo khoác">
                                    Áo khoác nổi bật
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <a class="nav-main-button"
                   asp-controller="Home"
                   asp-action="BoSuuTap">
                   Bộ sưu tập
               </a>

            </div>

            <div class="nav-actions">
                <a class="cart-btn"
                   asp-controller="Cart"
                   asp-action="Index">
                    <svg class="cart-icon"
                         viewBox="0 0 24 24"
                         fill="none"
                         aria-hidden="true">
                        <path d="M3 4h2l2.15 9.02a2 2 0 0 0 1.95 1.53h7.72a2 2 0 0 0 1.95-1.56L20 7H6"
                              stroke="currentColor"
                              stroke-width="1.9"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                        <circle cx="9.5" cy="19" r="1.25" fill="currentColor" />
                        <circle cx="17.5" cy="19" r="1.25" fill="currentColor" />
                    </svg>
                    Giỏ hàng
                    <span id="cartCount" class="cart-count">@cartQuantity</span>
                </a>

                @if (currentUser is not null)
                {
                    <div class="account-menu" data-account-menu>
                        <button id="accountMenuButton"
                                class="account-menu-trigger nav-profile-link"
                                type="button"
                                aria-haspopup="true"
                                aria-expanded="false"
                                aria-controls="accountDropdown">
                            <span class="nav-avatar">
                                @if (!string.IsNullOrWhiteSpace(layoutAvatarUrl))
                                {
                                    <img src="@layoutAvatarUrl" alt="Ảnh đại diện" />
                                }
                                else
                                {
                                    <span>@layoutAvatarInitial</span>
                                }
                            </span>

                            <span class="nav-profile-copy">
                                <span class="account-greeting">Xin chào</span>
                                <span class="nav-profile-text">@layoutDisplayName</span>
                            </span>

                            <svg class="account-chevron"
                                 viewBox="0 0 20 20"
                                 fill="none"
                                 aria-hidden="true">
                                <path d="m6 8 4 4 4-4"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                        </button>

                        <div id="accountDropdown"
                             class="account-dropdown"
                             role="menu"
                             aria-labelledby="accountMenuButton">
                            <a class="account-menu-link"
                               asp-controller="Account"
                               asp-action="Profile"
                               role="menuitem">
                                <span class="account-menu-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <circle cx="12" cy="8" r="3.5"
                                                stroke="currentColor" stroke-width="1.8" />
                                        <path d="M5.5 20c.55-4.1 2.75-6.15 6.5-6.15S17.95 15.9 18.5 20"
                                              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </span>
                                <span>
                                    <strong>Thông tin cá nhân</strong>
                                    <small>Xem và cập nhật tài khoản</small>
                                </span>
                            </a>

                            <a class="account-menu-link"
                               asp-controller="Account"
                               asp-action="MyOrders"
                               role="menuitem">
                                <span class="account-menu-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none">
                                        <path d="M6 4h12v16H6z"
                                              stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                        <path d="M9 8h6M9 12h6M9 16h4"
                                              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </span>
                                <span>
                                    <strong>Đơn hàng</strong>
                                    <small>Theo dõi lịch sử mua hàng</small>
                                </span>
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a class="account-menu-link account-admin-link"
                                   asp-controller="Admin"
                                   asp-action="Index"
                                   role="menuitem">
                                    <span class="account-menu-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M12 3.5 14.1 5l2.55-.25.85 2.4 2.15 1.4-.85 2.35.85 2.35-2.15 1.4-.85 2.4-2.55-.25L12 18.5l-2.1-1.7-2.55.25-.85-2.4-2.15-1.4.85-2.35-.85-2.35 2.15-1.4.85-2.4L9.9 5 12 3.5Z"
                                                  stroke="currentColor" stroke-width="1.55" stroke-linejoin="round" />
                                            <circle cx="12" cy="10.9" r="2.7"
                                                    stroke="currentColor" stroke-width="1.6" />
                                        </svg>
                                    </span>
                                    <span>
                                        <strong>Quản trị</strong>
                                        <small>Quản lý cửa hàng MENSTYLE</small>
                                    </span>
                                </a>
                            }

                            <div class="account-menu-divider"></div>

                            <form class="account-menu-logout"
                                  asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  role="none">
                                @Html.AntiForgeryToken()

                                <button class="account-menu-link account-logout-link"
                                        type="submit"
                                        role="menuitem">
                                    <span class="account-menu-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none">
                                            <path d="M10 5H5v14h5M14 8l4 4-4 4M8 12h10"
                                                  stroke="currentColor" stroke-width="1.8"
                                                  stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </span>
                                    <span>
                                        <strong>Đăng xuất</strong>
                                        <small>Thoát khỏi tài khoản hiện tại</small>
                                    </span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="nav-pill"
                       asp-controller="Account"
                       asp-action="Login">
                        Đăng nhập
                    </a>

                    <a class="nav-pill dark-pill"
                       asp-controller="Account"
                       asp-action="Register">
                        Đăng ký
                    </a>
                }
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="flash-message success">
            @successMessage
        </div>
    }

    @RenderBody()

    <footer id="contact" class="footer">
        <div class="container footer-grid">
            <div>
                <a class="logo footer-logo"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="home">
                    MEN<span>STYLE</span>
                </a>

                <p>
                    Website demo bán quần áo nam dành cho đồ án thiết kế giao diện
                    và web nâng cao.
                </p>
            </div>

            <div>
                <h4>Chính sách</h4>
                <a href="#">Đổi trả</a>
                <a href="#">Vận chuyển</a>
                <a href="#">Bảo mật</a>
            </div>

            <div>
                <h4>Liên hệ</h4>
                <p>Email: support@menstyle.vn</p>
                <p>Hotline: 0909 123 456</p>
            </div>
        </div>
    </footer>

    <div id="toast" class="toast">
        Đã thêm sản phẩm vào giỏ hàng
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_Chatbot" />
</body>
</html>
